        <name>Submit Feedback</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[function onClick() {
    var rating = g_form.getValue('u_rating');
    var comments = g_form.getValue('u_comments');
    var eventID = g_form.getValue('u_event_id');
    var attendeeID = g_form.getValue('u_attendee_id');

    if (!rating || !comments || !eventID || !attendeeID) {
        alert('Please fill in all fields: Rating, Comments, Event, and Attendee.');
        return;
    }

    var ga = new GlideAjax('FeedbackUtilsClient');
    ga.addParam('sysparm_name', 'submitFeedback');
    ga.addParam('sysparm_eventID', eventID);
    ga.addParam('sysparm_attendeeID', attendeeID);
    ga.addParam('sysparm_rating', rating);
    ga.addParam('sysparm_comments', comments);

    ga.getXMLAnswer(function(response) {
        var result = JSON.parse(response);
        if (result.success) {
            alert(result.message);
            g_form.clearValue('u_rating');
            g_form.clearValue('u_comments');
        } else {
            alert(result.message);
        }
    });
}
]]></script>
