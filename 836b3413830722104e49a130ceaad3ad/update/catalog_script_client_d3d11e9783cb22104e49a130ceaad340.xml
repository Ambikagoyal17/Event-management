        <name>Location Validation</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit(control, oldValue, newValue, isLoading) {
  if (isLoading || newValue == '') {
    return;
  }

  var location = g_form.getValue('u_location');
  var eventDate = g_form.getValue('u_event_date');

  if (!location || !eventDate) {
    return;
  }

  var ga = new GlideAjax('CheckEventLocationAvailability');
  ga.addParam('sysparm_name', 'isLocationAvailable');
  ga.addParam('sysparm_location', location);
  ga.addParam('sysparm_event_date', eventDate);
  ga.getXMLAnswer(function(response) {
    if (response === 'false') {
      g_form.showFieldMsg('u_location', 'This location is already booked for the selected date.', 'error');
     
    }
  });
}
]]></script>
