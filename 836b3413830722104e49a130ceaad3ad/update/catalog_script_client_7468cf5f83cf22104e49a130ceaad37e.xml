        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) return;

    var ga = new GlideAjax('VenueUtils');
    ga.addParam('sysparm_name', 'getVenueDetails');
    ga.addParam('sysparm_venue_name', newValue);

    ga.getXMLAnswer(function(response) {
        var data = JSON.parse(response);

        if (data.error) {
            g_form.showFieldMsg('u_venue_name', data.error, 'error');
            return;
        }

        // Fill fields if available
        g_form.setValue('u_location', data.location);
        g_form.setValue('u_capacity', data.capacity);
        g_form.setValue('u_contact_person', data.contact_person);
        g_form.setValue('u_contact_number', data.contact_number);
    });
}
]]></script>
