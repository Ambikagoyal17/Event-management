        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	var comment = current.u_comments.toLowerCase();

// Only auto-set rating if it's empty
if (current.u_rating.nil()) {
    if (comment.includes("excellent")) {
        current.u_rating = "excellent";
		current.update();
    } else if (comment.includes("good")) {
        current.u_rating = "good";
		current.update();
    } else if (comment.includes("poor")) {
        current.u_rating = "poor";
		current.update();
    } else if (comment.includes("bad") || comment.includes("terrible")) {
        current.u_rating = "bad";
		current.update();
    }
}


})(current, previous);]]></script>
