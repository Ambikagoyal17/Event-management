        <name>Cancel Task</name>
        <onclick>cancelTask()</onclick>
        <order>100</order>
        <script><![CDATA[function cancelTask() {
    var confirmation = confirm("Are you sure you want to cancel this task?");
    if (confirmation) {
        var ga = new GlideAjax('TaskUtilsClient');
        ga.addParam('sysparm_name', 'cancelTask');
        ga.addParam('sysparm_taskId', g_form.getUniqueValue());

        ga.getXMLAnswer(function(response) {
            if (response.trim() == 'success') {
                alert('Task has been cancelled.');

                // Update Client-side field — Use correct field name
                g_form.setValue('u_choice_4', 'cancelled'); // or 'status' based on actual column
                g_form.save();
            } else {
                alert('Failed to cancel the task.');
            }
        });
    }
}]]></script>
